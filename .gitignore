# Ortam / sırlar (7d: .env asla repo'ya girmez)
.env
# M-10/0: dağıtım sır dosyaları (.env.h200 vb.). `.env` deseni bunları KAPSAMAZ —
# yalnızca tam adı `.env` olan dosyayı eşler. `.env.h200` DB parolasını ve Langfuse
# anahtarlarını taşır; deseni olmadan tek `git add -A` ile repoya girerdi.
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# IDE
.idea/
.vscode/

# Runtime storage + ham korpus (HASSAS: GGB sunucu envanteri, telifli PDF'ler —
# repo'ya girmez; .env.example gibi şablonlar hariç)
var/
raw_files/

# OS
Thumbs.db
.DS_Store

# Yerel secret/kimlik notları ve Langfuse altyapı env (repo dışı)
db_info.md
docs/langfuse.env

# Geçici smoke korpusu
tmp/
docs/Langfuse_Dokumani.md

# Eval/karne koşum çıktıları (runtime artefaktı — repoya girmez)
logs/
