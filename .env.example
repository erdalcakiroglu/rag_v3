# ============================================================================
# ragintel — FAZ 1 ortam değişkenleri şablonu (İP-0)
# Kaynak: RAG_v2 Proje Dokümanı Bölüm 7d (dev ortamı)
# Öncelik zinciri: DB (ragintel.app_config) > ENV (bu dosya) > kod varsayılanı
# Kullanım: bu dosyayı `.env` olarak kopyalayın; `.env` .gitignore'dadır.
# ============================================================================

# --- Veritabanı bağlantısı (ZORUNLU: kod varsayılanı YOK) ---
# M-4 PARÇA 3: host/kullanıcı/parola artık koda gömülü DEĞİL. Tanımsızsa uygulama
# açık hata verir: "RAGINTEL_DB_HOST tanımsız (.env'de tanımlayın)".
RAGINTEL_DB_HOST=db.example.internal   # ŞABLON — gerçek host .env'de (repo dışı)
RAGINTEL_DB_PORT=5432
RAGINTEL_DB_NAME=ragintel
RAGINTEL_DB_USER=ragintel_app          # ŞABLON
RAGINTEL_DB_PASSWORD=changeme          # ŞABLON — gerçek parola .env dosyasında (repo dışı)
RAGINTEL_DB_SCHEMA=ragintel

# --- Pool / retry (opsiyonel; kod varsayılanları makuldür) ---
RAGINTEL_DB_POOL_MIN_SIZE=1
RAGINTEL_DB_POOL_MAX_SIZE=8
RAGINTEL_DB_CONNECT_TIMEOUT=10
RAGINTEL_DB_CONNECT_RETRIES=3
RAGINTEL_DB_CONNECT_BACKOFF_BASE=0.5

# --- Loglama ---
RAGINTEL_LOG_LEVEL=INFO
RAGINTEL_LOG_JSON=true

# --- Depo (İP-1 raw kopya) ---
RAGINTEL_STORAGE_ROOT=./var/storage

# --- Parse backend (İP-2): auto | docling | fallback ---
# auto = docling kuruluysa docling, yoksa pymupdf/python-docx yedek
RAGINTEL_PARSE_BACKEND=auto

# --- Embedding backend (İP-7 / ADR-012): remote Ollama HTTP ---
RAGINTEL_OLLAMA_BASE_URL=http://ollama.example.internal:11434   # ŞABLON, ZORUNLU
# M-4 PARÇA 1: embedding modeli artık DB'de (`app_config('embedding').model`, HF repo id).
# Bu ENV yalnızca bootstrap-fallback'tir; normalde BOŞ bırakın.
RAGINTEL_OLLAMA_MODEL=
RAGINTEL_OLLAMA_TIMEOUT=30
RAGINTEL_OLLAMA_RETRIES=3
RAGINTEL_OLLAMA_BACKOFF_BASE=0.5

# --- Rerank backend (ADR-014, OPSİYONEL) ---
# Boş bırakılırsa health "disabled" der (degrade etmez). `retrieval.rerank_backend='tei'`
# seçilirse ZORUNLU olur.
RAGINTEL_TEI_RERANK_URL=

# --- Redis oturum-cache'i (M-10/0 EK, OPSİYONEL) ---
# Boşsa cache devre dışı → auth resolver her istekte DB'ye gider (mevcut davranış,
# regresyonsuz). Doluysa token→user_ctx çözümü kısa TTL ile Redis'te önbelleklenir
# (DB kaynak-otoriter; iptaller anında invalidate edilir). TTL: app_config('auth').
# session_cache_ttl_seconds. Prod'da parola İÇEREN URL .env.h200'e yazılır (repoda YOK).
RAGINTEL_REDIS_URL=

# --- Agent LLM (FAZ 4) ---
RAGINTEL_LLM_API_BASE=http://llm.example.internal:11434   # ŞABLON, ZORUNLU
RAGINTEL_LLM_API_KEY=
RAGINTEL_LLM_MODEL=
# M-10/0: model bozuk tool-call JSON üretirse ("failed to parse JSON") AYRI retry sayısı.
# Model-agnostik dayanıklılık; rate-limit retry'sinden bağımsız. 0 → kapalı. Varsayılan 2.
RAGINTEL_LLM_TOOLCALL_RETRIES=2
# Retry PERTÜRBASYONU: düz retry temp=0'da AYNI bozuk çıktıyı verir (deterministik). Retry
# DENEMELERİNDE bu sıcaklık → model farklı üretir → geçerli JSON şansı. Normal yol temp=0
# kalır (karne zemini korunur). 0.0 → pertürbasyon kapalı. Varsayılan 0.5.
RAGINTEL_LLM_TOOLCALL_RETRY_TEMPERATURE=0.5

# --- Pipeline ayarları (ENV override; normalde DB app_config'ten okunur) ---
# Sözdizimi: RAGINTEL_<GRUP>_<ALAN>  (tek alt çizgi, 7d ev-stili)
# Örnekler (normalde DB kazanır — yalnızca DB'de olmayan grup/alan için etkili):
# RAGINTEL_EMBEDDING_BATCH_SIZE=8
# RAGINTEL_CHUNKING_MAX_TOKENS=512
# RAGINTEL_INGESTION_MAX_FILE_MB=100
